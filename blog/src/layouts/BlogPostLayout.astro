---
import '../styles/blog.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  date: Date;
  description: string;
}

const { title, date, description } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Match `src/index.html` so /blog/... (proxied or static) does not fall back to the dev default favicon -->
    <link rel="icon" type="image/jpg" href="/robot-icon.jpg" />
    <link rel="apple-touch-icon" href="/robot-icon.jpg" />
    <link
      rel="preconnect"
      href="https://fastly.jsdelivr.net"
      crossorigin
    />
  </head>
  <body class="blog-body">
    <header class="blog-header">
      <a class="blog-home-link" href="/">Thomas Mousseau</a>
      <nav class="blog-nav">
        <a href="/">Home</a>
        <a href="/publications">Publications</a>
      </nav>
    </header>
    <main class="blog-main">
      <article class="blog-article">
        <h1 class="blog-title">{title}</h1>
        <p class="blog-meta">{formatted}</p>
        <div class="blog-prose blog-prose--tufte">
          <slot />
        </div>
      </article>
    </main>
  </body>
</html>
